{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "noEmit": true,
    "noErrorTruncation": true,
    "target": "es2022",
    "moduleResolution": "node16",
    "module": "node16",
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "types": ["node"]
  },
  "exclude": ["node_modules"]
}
